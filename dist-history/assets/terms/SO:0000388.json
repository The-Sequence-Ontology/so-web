{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0000388","compactId":"SO_0000388","id":"SO:0000388","label":"RRE_RNA","definition":{"text":"The Rev response element (RRE) is encoded within the HIV-env gene. Rev is an essential regulatory protein of HIV that binds an internal loop of the RRE leading, encouraging further Rev-RRE binding. This RNP complex is critical for mRNA export and hence for expression of the HIV structural proteins.","xrefs":["http://www.sanger.ac.uk/cgi-bin/Rfam/getacc?RF00036"]},"comments":[],"synonyms":[{"scope":"exact","value":"RRE RNA"}],"xrefs":[],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0000388/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0000370"],"children":[],"ancestors":["SO:0000370","SO:0002247","SO:0000655","SO:0000233","SO:0000673","SO:0000831","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0000370"],"children":[],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0000370","id":"SO:0000370","label":"small_regulatory_ncRNA"}],"children":[],"related":[]}}