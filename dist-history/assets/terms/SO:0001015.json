{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0001015","compactId":"SO_0001015","id":"SO:0001015","label":"wobble_base_pair","definition":{"text":"A type of non-canonical base pairing, most commonly between G and U, which is important for the secondary structure of RNAs. It has similar thermodynamic stability to the Watson-Crick pairing. Wobble base pairs only have two hydrogen bonds. Other wobble base pair possibilities are I-A, I-U and I-C.","xrefs":["PMID:11256617"]},"comments":[],"synonyms":[{"scope":"exact","value":"wobble base pair"},{"scope":"exact","value":"wobble pair"}],"xrefs":["http://en.wikipedia.org/wiki/Wobble_base_pair"],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0001015/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0000028"],"children":[],"ancestors":["SO:0000028","SO:0000002","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0000028"],"children":[],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0000028","id":"SO:0000028","label":"base_pair"}],"children":[],"related":[]}}