{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0001111","compactId":"SO_0001111","id":"SO:0001111","label":"beta_strand","definition":{"text":"A beta strand describes a single length of polypeptide chain that forms part of a beta sheet. A single continuous stretch of amino acids adopting an extended conformation of hydrogen bonds between the N-O and the C=O of another part of the peptide. This forms a secondary protein structure in which two or more extended polypeptide regions are hydrogen-bonded to one another in a planar array.","xrefs":["EBIBS:GAR","UniProt:curation_manual"]},"comments":["Range."],"synonyms":[{"scope":"related","value":"strand"}],"xrefs":["http://en.wikipedia.org/wiki/Beta_sheet"],"subsets":["biosapiens"],"altIds":["BS:00042"],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0001111/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0001078"],"children":["SO:0001112","SO:0001113"],"ancestors":["SO:0001078","SO:0001070","SO:0000839","SO:0001411","SO:0000001","SO:0000110"],"descendants":["SO:0001112","SO:0001113"],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0001078"],"children":["http://purl.obolibrary.org/obo/SO_0001112","http://purl.obolibrary.org/obo/SO_0001113"],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0001078","id":"SO:0001078","label":"polypeptide_secondary_structure"}],"children":[{"iri":"http://purl.obolibrary.org/obo/SO_0001112","id":"SO:0001112","label":"antiparallel_beta_strand"},{"iri":"http://purl.obolibrary.o