<header class="site-header">
  <div class="shell">
    <div class="masthead">
      <p class="kicker">{{ site.kicker }}</p>
      <h1>{{ site.name }}</h1>
      <p>{{ site.description }}</p>
      <nav class="nav" aria-label="Primary">
        {% for item in navigation %}
        <a href="{{ item.url | href(page.url) }}">{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </div>
</header>
