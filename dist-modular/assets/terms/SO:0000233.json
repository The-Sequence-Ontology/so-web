{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0000233","compactId":"SO_0000233","id":"SO:0000233","label":"mature_transcript","definition":{"text":"A transcript which has undergone the necessary modifications, if any, for its function. In eukaryotes this includes, for example, processing of introns, cleavage, base modification, and modifications to the 5' and/or the 3' ends, other than addition of bases. In bacteria functional mRNAs are usually not modified.","xrefs":["SO:ke"]},"comments":["A processed transcript cannot contain introns."],"synonyms":[{"scope":"exact","value":"mature transcript"}],"xrefs":["http://en.wikipedia.org/wiki/Mature_transcript"],"subsets":["SOFA"],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0000233/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files","issueRefs":[]},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files","issueRefs":[]},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files","issueRefs":[]}],"semanticEvents":[{"type":"created","date":"2016-12-05","commit":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","subject":"Add renamed SO files","summary":"Term introduced into the editable ontology history","details":["Initial label: mature_transcript","Initial definition captured.","Initial parent: SO:0000673"],"issueRefs":[]}]},"parents":["SO:0000673"],"children":["SO:0000234","SO:0000655"],"ancestors":["SO:0000673","SO:0000831","SO:0001411","SO:0000001","SO:0000110"],"descendants":["SO:0000234","SO:0000655","SO:1001261","SO:0000871","SO:0000929","SO:0002292","SO:0000634","SO:0000995","SO:0000872","SO:0000633","SO:0002130","SO:0000734","SO:0000108","SO:0000862","SO:0002340","SO:000