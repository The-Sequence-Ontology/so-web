{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0000404","compactId":"SO_0000404","id":"SO:0000404","label":"vault_RNA","definition":{"text":"A family of RNAs are found as part of the enigmatic vault ribonucleoprotein complex. The complex consists of a major vault protein (MVP), two minor vault proteins (VPARP and TEP1), and several small untranslated RNA molecules. It has been suggested that the vault complex is involved in drug resistance.","xrefs":["http://www.sanger.ac.uk/cgi-bin/Rfam/getacc?RF00006"]},"comments":[],"synonyms":[{"scope":"exact","value":"INSDC_qualifier:vault_RNA"},{"scope":"exact","value":"vault RNA"},{"scope":"broad","value":"INSDC_feature:ncRNA"}],"xrefs":["http://en.wikipedia.org/wiki/Vault_RNA"],"subsets":["SOFA"],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0000404/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"5fe48bd4b720f8b140cb0f77461798c55532c097","shortHash":"5fe48bd","date":"2018-01-26","subject":"Add INSDC mappings"},"entries":[{"hash":"5fe48bd4b720f8b140cb0f77461798c55532c097","shortHash":"5fe48bd","date":"2018-01-26","subject":"Add INSDC mappings"},{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0000655"],"children":[],"ancestors":["SO:0000655","SO:0000233","SO:0000673","SO:0000831","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0000655"],"children":[],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0000655","id":"SO:0000655","label":"ncRNA"}],"children":[],"related":[]}}