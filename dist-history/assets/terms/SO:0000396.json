{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0000396","compactId":"SO_0000396","id":"SO:0000396","label":"U6_snRNA","definition":{"text":"U6 snRNA is a component of the spliceosome which is involved in splicing pre-mRNA. The putative secondary structure consensus base pairing is confined to a short 5' stem loop, but U6 snRNA is thought to form extensive base-pair interactions with U4 snRNA.","xrefs":["http://www.sanger.ac.uk/cgi-bin/Rfam/getacc?RF00015"]},"comments":[],"synonyms":[{"scope":"exact","value":"U6 small nuclear RNA"},{"scope":"exact","value":"U6 snRNA"},{"scope":"exact","value":"small nuclear RNA U6"},{"scope":"exact","value":"snRNA U6"}],"xrefs":["http://en.wikipedia.org/wiki/U6_snRNA"],"subsets":["SOFA"],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0000396/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0000274"],"children":[],"ancestors":["SO:0000274","SO:0002247","SO:0000655","SO:0000233","SO:0000673","SO:0000831","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0000274"],"children":[],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0000274","id":"SO:0000274","label":"snRNA"}],"children":[],"related":[]}}