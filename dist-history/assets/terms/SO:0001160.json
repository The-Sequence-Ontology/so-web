{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0001160","compactId":"SO_0001160","id":"SO:0001160","label":"DMv3_motif","definition":{"text":"A sequence element characteristic of some RNA polymerase II promoters, usually located between -30 and +15 relative to the TSS. Consensus sequence is KNNCAKCNCTRNY. Tends to co-occur with DMv2 (SO:0001161). Tends to not occur with DPE motif (SO:0000015) or MTE (0001162).","xrefs":["PMID:12537576:16827941"]},"comments":[],"synonyms":[{"scope":"exact","value":"DMv3"},{"scope":"exact","value":"DMv3 motif"},{"scope":"exact","value":"directional motif v3"},{"scope":"exact","value":"promoter motif 7"},{"scope":"narrow","value":"KNNCAKCNCTRNY"}],"xrefs":[],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0001160/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0001659"],"children":[],"ancestors":["SO:0001659","SO:0000713","SO:0000714","SO:0001683","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[{"predicate":"http://purl.obolibrary.org/obo/so#part_of","target":"SO:0000170"}],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0001659"],"children":[],"related":["http://purl.obolibrary.org/obo/SO_0000170"]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0001659","id":"SO:0001659","label":"promoter_element"}],"children":[],"related":[{"iri":"http://purl.obolibrary.org/obo/SO_0000170","id":"SO:0000170","label":"RNApol_II_promoter"}]}}