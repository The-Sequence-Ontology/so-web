---
layout: layouts/base.njk
browserPage: true
---
<p class="breadcrumbs" data-browser-breadcrumbs><a href="{{ '/index.html' | href(page.url) }}">Home</a> / <a href="{{ '/browser/current_release/index.html' | href(page.url) }}">Current release</a> / {{ term.id }}</p>
{% include "term-notice.njk" %}
<div class="ontology-browser" data-ontology-browser data-term-base="{{ '/browser/current_release/term/' | href(page.url) }}">
{% include "ontology-sidebar.njk" %}
<article class="grid" id="term-details" data-browser-content data-term-id="{{ term.id }}" data-term-label="{{ term.label or term.id }}" tabindex="-1">
  <section class="card term-summary">
    <div class="term-header">
      <div>
        <h2>{{ term.label or term.id }}</h2>
        <p class="term-id">{{ term.id }}</p>
      </div>
      {% if term.isObsolete %}<span class="pill obsolete">Obsolete term</span>{% endif %}
    </div>
    <p class="lede term-definition"><strong>Definition:</strong> <em>{{ term.definition.text or "No definition available in the current release." }}</em></p>
    {% if term.isObsolete %}
    <p><strong>Status:</strong> This term is marked obsolete in the current release.{% if term.replacements.length %} Replacement guidance: {% for replacement in term.replacements %}<a href="{{ replacement.url | href(page.url) }}">{{ replacement.id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>
    {% endif %}
  </section>
  {% include "term/notes.njk" %}
  <section class="grid two">
    <section class="card">
      <h3>Synonyms</h3>
      {% if term.synonyms.length %}
      <table class="synonyms-table"><thead><tr><th scope="col">Scope</th><th scope="col">Value</th></tr></thead><tbody>{% for synonym in term.synonyms %}<tr><td>{{ synonym.scope }}</td><td>{{ synonym.value }}</td></tr>{% endfor %}</tbody></table>
      {% else %}
      <p class="muted">No synonyms recorded in the OWL annotations.</p>
      {% endif %}
    </section>
    <section class="card">
      <h3>Identifiers and subsets</h3>
      <p><strong>Accession:</strong> {{ term.id }}</p>
      <p><strong>Persistent URL:</strong> <a href="{{ term.iri }}">{{ term.iri }}</a></p>
      <p><strong>Alternate IDs:</strong> {{ term.altIds | join(", ") if term.altIds.length else "None" }}</p>
      <p><strong>Subsets:</strong> {{ term.subsets | join(", ") if term.subsets.length else "None" }}</p>
      <p><strong>Cross references:</strong> {{ term.xrefs | join(", ") if term.xrefs.length else "None" }}</p>
    </section>
    <section class="card">
      <h3>History summary</h3>
      <p class="muted">Term history is reconstructed from the Git-era ontology files by comparing ontology classes across revisions. Earlier SVN-era changes will be added at a future date.</p>
      <p><strong>First seen in Git-era editable history:</strong> {% if term.history.firstSeen %}{{ term.history.firstSeen.date }} in commit {{ term.history.firstSeen.shortHash }}{% else %}No stanza history found in so-edit.obo{% endif %}</p>
      <p><strong>Most recent Git-era change:</strong> {% if term.history.mostRecent %}{{ term.history.mostRecent.date }} in commit {{ term.history.mostRecent.shortHash }}{% else %}No recorded changes{% endif %}</p>
      <p><strong>Number of changes:</strong> {{ term.history.semanticEvents.length }}</p>
    </section>
  </section>
  {% include "term/graph.njk" %}
  {% include "term/relationships.njk" %}
  {% include "term/history.njk" %}
</article>
</div>
<script src="{{ '/assets/ontology-tree.js' | href(page.url) }}" type="module"></script>
<script src="{{ '/assets/browser-navigation.js' | href(page.url) }}" type="module"></script>
