{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0000384","compactId":"SO_0000384","id":"SO:0000384","label":"OxyS_RNA","definition":{"text":"A small untranslated RNA which is induced in response to oxidative stress in Escherichia coli. Acts as a global regulator to activate or repress the expression of as many as 40 genes, including the fhlA-encoded transcriptional activator and the rpoS-encoded sigma(s) subunit of RNA polymerase. OxyS is bound by the Hfq protein, that increases the OxyS RNA interaction with its target messages.","xrefs":["http://www.sanger.ac.uk/cgi-bin/Rfam/getacc?RF00035"]},"comments":[],"synonyms":[{"scope":"exact","value":"OxyS RNA"}],"xrefs":["http://en.wikipedia.org/wiki/OxyS_RNA"],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0000384/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0000370"],"children":[],"ancestors":["SO:0000370","SO:0002247","SO:0000655","SO:0000233","SO:0000673","SO:0000831","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0000370"],"children":[],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0000370","id":"SO:0000370","label":"small_regulatory_ncRNA"}],"children":[],"related":[]}}