<aside class="term-update-notice" data-term-notice aria-label="Term update" hidden>
  <p data-term-notice-message role="status" aria-live="polite" aria-atomic="true"></p>
  <div class="term-update-actions">
    <button type="button" data-term-notice-view>Go to top ↑</button>
    <a data-term-notice-open hidden>Open term page ↗</a>
    <button type="button" data-term-notice-dismiss aria-label="Dismiss term update">×</button>
  </div>
</aside>
