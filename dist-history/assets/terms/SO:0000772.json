{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0000772","compactId":"SO_0000772","id":"SO:0000772","label":"genomic_island","definition":{"text":"A genomic island is an integrated mobile genetic element, characterized by size (over 10 Kb). It that has features that suggest a foreign origin. These can include nucleotide distribution (oligonucleotides signature, CG content etc.) that differs from the bulk of the chromosome and/or genes suggesting DNA mobility.","xrefs":["Phigo:at","SO:ke"]},"comments":["Genomic islands are transmissible elements characterized by large size (>10kb)."],"synonyms":[{"scope":"exact","value":"genomic island"}],"xrefs":["http://en.wikipedia.org/wiki/Genomic_island"],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0000772/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0001039"],"children":["SO:0001049","SO:0001007","SO:0000775","SO:0000776","SO:0000773","SO:0000774"],"ancestors":["SO:0001039","SO:0001037","SO:0001411","SO:0000001","SO:0000110"],"descendants":["SO:0001049","SO:0001007","SO:0000775","SO:0000776","SO:0000773","SO:0000774"],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0001039"],"children":["http://purl.obolibrary.org/obo/SO_0001049","http://purl.obolibrary.org/obo/SO_0001007","http://purl.obolibrary.org/obo/SO_0000775","http://purl.obolibrary.org/obo/SO_0000776","http://purl.obolibrary.org/obo/SO_0000773","http://purl.obolibrary.org/obo/SO_0000774"],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibr