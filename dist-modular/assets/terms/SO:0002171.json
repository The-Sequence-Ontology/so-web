{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0002171","compactId":"SO_0002171","id":"SO:0002171","label":"telomeric_D_loop","definition":{"text":"A telomeric D-loop is a three-stranded DNA displacement loop that forms at the site where the telomeric 3' single-stranded DNA overhang (formed of the repeat sequence TTAGGG in mammals) is tucked back inside the double-stranded component of telomeric DNA molecule, thus forming a t-loop or telomeric-loop and protecting the chromosome terminus.","xrefs":["PMID:10338204","PMID:15071557","PMID:24012755"]},"comments":["This definition is from GO:0061820 telomeric D-loop disassembly."],"synonyms":[{"scope":"exact","value":"telomeric D loop"}],"xrefs":[],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0002171/","history":{"firstSeen":{"hash":"304511d5491ecef55652a5d6dc2660cef860efbc","shortHash":"304511d","date":"2017-08-01","subject":"Add telomeric_D_loop","issueRefs":[]},"mostRecent":{"hash":"304511d5491ecef55652a5d6dc2660cef860efbc","shortHash":"304511d","date":"2017-08-01","subject":"Add telomeric_D_loop","issueRefs":[]},"entries":[{"hash":"304511d5491ecef55652a5d6dc2660cef860efbc","shortHash":"304511d","date":"2017-08-01","subject":"Add telomeric_D_loop","issueRefs":[]}],"semanticEvents":[{"type":"created","date":"2017-08-01","commit":"304511d5491ecef55652a5d6dc2660cef860efbc","shortHash":"304511d","subject":"Add telomeric_D_loop","summary":"Term introduced into the editable ontology history","details":["Initial label: telomeric_D_loop","Initial definition captured.","Initial parent: SO:0000296"],"issueRefs":[]}]},"parents":["SO:0000296"],"children":[],"ancestors":["SO:0000296","SO:0001411","SO:0000001","SO:0000110"],"descendants":[],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0000296"],"children":[],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0000296","id":"SO:00