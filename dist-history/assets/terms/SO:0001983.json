{"term":{"iri":"http://purl.obolibrary.org/obo/SO_0001983","compactId":"SO_0001983","id":"SO:0001983","label":"5_prime_UTR_premature_start_codon_variant","definition":{"text":"A 5' UTR variant where a premature start codon is introduced, moved or lost.","xrefs":["SANGER:am"]},"comments":["Requested by Andy Menzies at the Sanger. This isn't necessarily a protein coding change. A premature start codon can effect the production of a mature protein product by providing a competing translation start point. Some genes balance their expression this way, eg THPO requires the presence of a premature start to limit expression, its loss leads to Familial thrombocythemia."],"synonyms":[{"scope":"exact","value":"5' UTR premature start codon variant"}],"xrefs":[],"subsets":[],"altIds":[],"namespace":"sequence","isObsolete":false,"replacedBy":[],"canonicalUrl":"/browser/current_release/term/SO:0001983/","history":{"firstSeen":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"mostRecent":{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"},"entries":[{"hash":"92e3cae9f3d39e5979110bad332c5fadf7a4b3ab","shortHash":"92e3cae","date":"2016-12-05","subject":"Add renamed SO files"}]},"parents":["SO:0001623"],"children":["SO:0001989","SO:0001988","SO:0001990"],"ancestors":["SO:0001623","SO:0001622","SO:0001968","SO:0001791","SO:0001576","SO:0001564","SO:0001878","SO:0001537","SO:0001060"],"descendants":["SO:0001989","SO:0001988","SO:0001990"],"relationships":[],"graphNeighborhood":{"parents":["http://purl.obolibrary.org/obo/SO_0001623"],"children":["http://purl.obolibrary.org/obo/SO_0001989","http://purl.obolibrary.org/obo/SO_0001988","http://purl.obolibrary.org/obo/SO_0001990"],"related":[]}},"graph":{"parents":[{"iri":"http://purl.obolibrary.org/obo/SO_0001623","id":"SO:0001623","label":"5_prime_UTR_variant"}],"children":[{"iri":"http://p